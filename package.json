    "@tanstack/react-virtual": "^3.14.13",
    "@types/jszip": "^3.4.0",
    "chrono-node": "^2.10.1",
    "d3-force": "^3.0.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "perfect-freehand": "^1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
